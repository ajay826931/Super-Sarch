# ==============================================================================
# KHM (Kota Hostels & Mess) - Environment Variables Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development and fill in your credentials.
# DO NOT commit `.env.local` or any sensitive credentials to version control.

# MongoDB Connection String (Atlas or Local instance with replica set for transactions)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/khm_database?retryWrites=true&w=majority"

# Cloudinary Media Storage (For Property and Service Images)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Upstash Redis (For caching distance matrix and walking time computations)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Google Sheets Webhook URL (Google Apps Script Web App for auto-syncing student leads)
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/your-deployment-id/exec"

# JWT Authentication Secret (Used to sign vendor session tokens)
JWT_SECRET="your_secure_random_jwt_secret_key_min_32_characters"

# Nodemailer / SMTP Configuration (For Vendor Passwordless Email OTP Login)
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-email-app-password"
EMAIL_FROM="your-verified-sender@example.com"
